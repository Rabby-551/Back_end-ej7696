# RevenueCat server API v2 key. Required permissions:
# customer_information:customers:read
# customer_information:subscriptions:read_write
# customer_information:purchases:read
# project_configuration:products:read
REVENUECAT_V2_SECRET_KEY=sk_your_revenuecat_v2_secret_key
REVENUECAT_PROJECT_ID=proj_your_project_id
REVENUECAT_PRO_ENTITLEMENT_ID=entl_your_entitlement_id
REVENUECAT_PRO_ENTITLEMENT_LOOKUP_KEY=professional_access
REVENUECAT_IOS_PRODUCT_ID=six_month_subscriptions
REVENUECAT_ANDROID_PRODUCT_ID=six_month_subscriptions:six-month
# Set once to the production migration deployment timestamp and never change it.
# Legacy lifetime purchases restored later receive six months from this anchor.
EXAM_SUBSCRIPTION_MIGRATION_AT=2026-08-13T00:00:00.000Z
# Configure these nine per-exam six-month products in RevenueCat. iOS uses the
# product ID before `:`; Android uses the full product/base-plan identifier.
# com.inspectorspath.exam.api1184.sixmonth:api1184sixmonth
# com.inspectorspath.exam.api510.sixmonth:api510sixmonth
# com.inspectorspath.exam.api570.sixmonth:api570sixmonth
# com.inspectorspath.exam.api653.sixmonth:api653sixmonth
# com.inspectorspath.exam.api936.sixmonth:api936sixmonth
# com.inspectorspath.exam.api1169.sixmonth:api1169sixmonth
# com.inspectorspath.exam.siee.sixmonth:sieesixmonth
# com.inspectorspath.exam.sife.sixmonth:sifesixmonth
# com.inspectorspath.exam.sire.sixmonth:siresixmonth

# Generate a long random value and enter `Bearer <this value>` in the
# RevenueCat webhook Authorization header field.
REVENUECAT_WEBHOOK_AUTH_TOKEN=replace_with_a_long_random_token

# Optional but recommended. Enable HMAC signing in RevenueCat, copy the
# one-time signing secret here, and keep the default five-minute tolerance.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
